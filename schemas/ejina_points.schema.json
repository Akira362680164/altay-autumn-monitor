{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Akira362680164/altay-autumn-monitor/main/schemas/ejina_points.schema.json",
  "title": "Ejina weather-only point registry",
  "type": "object",
  "required": ["schema_version", "namespace", "timezone", "history_start_month_day", "forecast_end_date", "regions", "points"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.1.0"},
    "namespace": {"type": "string", "const": "ejina"},
    "timezone": {"type": "string", "const": "Asia/Shanghai"},
    "history_start_month_day": {"type": "string", "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"},
    "forecast_end_date": {"type": "string", "format": "date"},
    "regions": {
      "type": "object",
      "minProperties": 3,
      "additionalProperties": {
        "type": "object",
        "required": ["name", "core_point_id", "history_start_month_day", "forecast_end_date"],
        "properties": {
          "name": {"type": "string"},
          "core_point_id": {"type": "string"},
          "primary_visit_date": {"type": ["string", "null"], "format": "date"},
          "visit_dates": {"type": "array", "items": {"type": "string", "format": "date"}},
          "history_start_month_day": {"type": "string"},
          "forecast_end_date": {"type": "string", "format": "date"}
        },
        "additionalProperties": true
      }
    },
    "points": {
      "type": "object",
      "minProperties": 3,
      "additionalProperties": {
        "type": "object",
        "required": ["name", "region", "status", "role", "latitude", "longitude", "coordinate_verification"],
        "properties": {
          "name": {"type": "string"},
          "region": {"type": "string"},
          "status": {"type": "string", "enum": ["VERIFIED", "PROVISIONAL", "ROUTE_NOT_VERIFIED"]},
          "role": {"type": "string"},
          "latitude": {"type": "number", "minimum": -90, "maximum": 90},
          "longitude": {"type": "number", "minimum": -180, "maximum": 180},
          "forecast_end_date": {"type": "string", "format": "date"},
          "coordinate_verification": {
            "type": "object",
            "required": ["status", "sources"],
            "properties": {
              "status": {"const": "VERIFIED"},
              "sources": {"type": "array", "minItems": 1, "items": {"type": "object"}}
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
