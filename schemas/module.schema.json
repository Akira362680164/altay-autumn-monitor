{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Akira362680164/altay-autumn-monitor/main/schemas/module.schema.json",
  "title": "Altay Autumn Monitor module envelope",
  "type": "object",
  "required": ["schema_version", "module", "status", "generated_at", "data_date"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.1.0"},
    "module": {"type": "string", "enum": ["hres", "history", "history_forward", "ensemble", "gfs", "single_runs", "spatial_sampling", "long_range_background", "grid_registry", "phenology_weather_summary"]},
    "status": {"type": "string", "enum": ["OK", "PARTIAL", "FAILED", "SKIPPED"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "data_date": {"type": "string", "format": "date"},
    "history_years": {"type": "array", "items": {"type": "integer"}}
  },
  "additionalProperties": true
}
